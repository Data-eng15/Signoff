# OS cruft
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/
npm-debug.log*

# Env / secrets — never commit real values, only ${user_config.*} placeholders belong in tracked files
.env
.env.local

# Observability dashboard runtime state (per-project, not part of this repo's own history)
rollup.db

# This repo is the kit itself, not a project the kit gets installed into.
# A .claude/ showing up here means something got run from the wrong directory.
.claude/
